rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema Validation Helpers
    function isValidUserProfile(data, userId) {
      return data.id is string && data.id == userId
        && (!('name' in data) || (data.name is string && data.name.size() <= 256));
    }

    function isValidContract(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == userId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 256;
    }

    function isValidCategory(data) {
      return data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128;
    }

    // Collection: Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII isolation: prevent listing all user profiles
      allow create, update: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId);

      // Subcollection: Contracts
      match /contracts/{contractId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidContract(incoming(), userId);
        allow update: if isOwner(userId) && isValidContract(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Categories
      match /categories/{categoryId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCategory(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
